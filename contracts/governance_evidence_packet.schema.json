{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse360.local/contracts/governance_evidence_packet.schema.json",
  "title": "Pulse360 Governance Evidence Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_packet_id",
    "subject_type",
    "subject_id",
    "source_account_id",
    "served_attribute_name",
    "served_attribute_value_hash",
    "source_contributions",
    "lineage_refs",
    "confidence",
    "freshness_status",
    "run_id",
    "generated_at",
    "validation_status",
    "regulator_readiness"
  ],
  "properties": {
    "evidence_packet_id": {
      "type": "string"
    },
    "subject_type": {
      "type": "string",
      "enum": [
        "firmographic_attribute",
        "sovereign_identifier",
        "classification",
        "corporate_linkage",
        "model_score",
        "llm_narrative",
        "steward_decision"
      ]
    },
    "subject_id": {
      "type": "string"
    },
    "source_account_id": {
      "type": "string",
      "description": "Salesforce Account ID used as the CRM activation key."
    },
    "served_attribute_name": {
      "type": "string"
    },
    "served_attribute_value_hash": {
      "type": "string"
    },
    "source_contributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_family",
          "source_type",
          "source_url",
          "source_confidence",
          "source_weight",
          "freshness_status",
          "license_or_contract_reference"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_family": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source_weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "freshness_status": {
            "type": "string"
          },
          "license_or_contract_reference": {
            "type": "string"
          }
        }
      }
    },
    "lineage_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lineage_system",
          "upstream_table",
          "downstream_table",
          "lineage_status"
        ],
        "properties": {
          "lineage_system": {
            "type": "string",
            "enum": [
              "unity_catalog",
              "data_cloud_mapping",
              "salesforce_audit",
              "manual_runbook"
            ]
          },
          "upstream_table": {
            "type": "string"
          },
          "downstream_table": {
            "type": "string"
          },
          "lineage_status": {
            "type": "string",
            "enum": [
              "verified",
              "pending_runtime_check",
              "not_applicable"
            ]
          }
        }
      }
    },
    "model_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feature_snapshot_id": {
          "type": "string"
        },
        "model_family": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "registered_model_name": {
          "type": "string"
        },
        "scored_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "llm_audit_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "llm_input_hash": {
          "type": "string"
        },
        "llm_output_hash": {
          "type": "string"
        },
        "citation_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "salesforce_audit_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "governance_case_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "downstream_update_status": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "freshness_status": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "expired",
        "unknown"
      ]
    },
    "run_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "passed",
        "review_required",
        "failed"
      ]
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regulator_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready_for_demo",
        "ready_for_external_audit",
        "reason"
      ],
      "properties": {
        "ready_for_demo": {
          "type": "boolean"
        },
        "ready_for_external_audit": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
