{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pulse360/contracts/firmographic_source_adapter",
  "title": "Pulse360 Firmographic Source Adapter Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_adapter_id",
    "source_family",
    "source_system",
    "source_dataset",
    "ingestion_mode",
    "payload_format",
    "country_scope",
    "provider_or_source_id_role",
    "identity_key_policy",
    "approved_fact_types",
    "license_or_use_basis",
    "allowed_use",
    "retention_policy",
    "redistribution_allowed",
    "row_level_identity_allowed",
    "refresh_sla",
    "approval_status",
    "run_metadata_required",
    "lineage_required",
    "governance_owner",
    "last_reviewed_at"
  ],
  "properties": {
    "source_adapter_id": { "type": "string", "pattern": "^src_adapter_[a-z0-9_]+$" },
    "source_family": {
      "type": "string",
      "enum": [
        "national_registry",
        "commercial_provider_marketplace",
        "customer_internal",
        "internet_research",
        "clean_room_collaboration"
      ]
    },
    "source_system": { "type": "string", "minLength": 1 },
    "source_dataset": { "type": "string", "minLength": 1 },
    "ingestion_mode": {
      "type": "string",
      "enum": [
        "registry_snapshot",
        "regulator_filing",
        "marketplace_delta_share",
        "delta_sharing",
        "lakeflow_connect",
        "approved_connector",
        "document_extraction",
        "clean_room_output",
        "manual_fixture"
      ]
    },
    "payload_format": {
      "type": "string",
      "enum": ["json", "csv", "parquet", "delta_table", "pdf_text", "html_text", "aggregate_table"]
    },
    "country_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2, "maxLength": 2 }
    },
    "provider_or_source_id_role": {
      "type": "string",
      "enum": [
        "sovereign_candidate_when_official",
        "xref_only",
        "crm_safe_join_only",
        "evidence_only",
        "aggregate_signal_only"
      ]
    },
    "identity_key_policy": {
      "type": "string",
      "enum": [
        "sovereign_candidate_official_only",
        "xref_only",
        "crm_safe_join_only",
        "evidence_only",
        "aggregate_only"
      ]
    },
    "approved_fact_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "company_identity",
          "official_identifier",
          "location",
          "classification",
          "legal_status",
          "financial",
          "workforce_scale",
          "hierarchy_hint",
          "contact_web_presence",
          "digital_signal",
          "aggregate_signal"
        ]
      }
    },
    "license_or_use_basis": { "type": "string", "minLength": 1 },
    "allowed_use": { "type": "string", "minLength": 1 },
    "retention_policy": { "type": "string", "minLength": 1 },
    "redistribution_allowed": { "type": "boolean" },
    "row_level_identity_allowed": { "type": "boolean" },
    "refresh_sla": { "type": "string", "minLength": 1 },
    "approval_status": {
      "type": "string",
      "enum": ["approved_for_demo", "approved_for_processing", "gated_contract_required", "rejected"]
    },
    "run_metadata_required": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "run_timestamp", "source_retrieved_at", "license_or_contract_reference"],
      "properties": {
        "run_id": { "const": true },
        "run_timestamp": { "const": true },
        "source_retrieved_at": { "const": true },
        "license_or_contract_reference": { "const": true }
      }
    },
    "lineage_required": { "type": "boolean", "const": true },
    "governance_owner": { "type": "string", "minLength": 1 },
    "last_reviewed_at": { "type": "string", "format": "date" },
    "notes": { "type": ["string", "null"] }
  }
}
