{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pulse360/contracts/firmographic_research_document",
  "title": "Pulse360 Governed Firmographic Research Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "research_document_id",
    "source_type",
    "source_url",
    "document_title",
    "document_date",
    "accessed_at",
    "license_or_use_basis",
    "account_candidate",
    "extracted_facts",
    "approval_status",
    "run_id",
    "run_timestamp"
  ],
  "properties": {
    "research_document_id": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": ["approved_public_url", "approved_public_pdf", "approved_provider_export", "manual_research_note"]
    },
    "source_url": { "type": ["string", "null"], "format": "uri" },
    "document_title": { "type": "string", "minLength": 1 },
    "document_date": { "type": ["string", "null"], "format": "date" },
    "accessed_at": { "type": "string", "format": "date-time" },
    "license_or_use_basis": { "type": "string", "minLength": 1 },
    "account_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company_name", "country"],
      "properties": {
        "company_name": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "minLength": 2, "maxLength": 2 },
        "website_domain": { "type": ["string", "null"] },
        "resolved_entity_id": { "type": ["string", "null"] },
        "sovereign_identity_key": { "type": ["string", "null"] },
        "crm_safe_activation_key": { "type": ["string", "null"], "minLength": 15, "maxLength": 18 },
        "identity_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      }
    },
    "extracted_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_type",
          "fact_name",
          "fact_value",
          "source_excerpt",
          "extraction_confidence"
        ],
        "properties": {
          "fact_type": { "type": "string", "minLength": 1 },
          "fact_name": { "type": "string", "minLength": 1 },
          "fact_value": { "type": ["string", "number", "integer", "boolean", "null"] },
          "fact_value_normalized": { "type": ["string", "number", "integer", "boolean", "null"] },
          "fact_unit": { "type": ["string", "null"] },
          "fact_period_start": { "type": ["string", "null"], "format": "date" },
          "fact_period_end": { "type": ["string", "null"], "format": "date" },
          "source_excerpt": { "type": "string", "minLength": 1 },
          "extraction_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "approval_status": { "type": "string", "enum": ["approved_for_demo", "approved_for_processing", "review_required", "rejected"] },
    "run_id": { "type": "string", "minLength": 1 },
    "run_timestamp": { "type": "string", "format": "date-time" }
  }
}
