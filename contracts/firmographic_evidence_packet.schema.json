{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pulse360/contracts/firmographic_evidence_packet",
  "title": "Pulse360 Firmographic Evidence Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_packet_id",
    "account_context",
    "resolved_identity",
    "firmographic_facts",
    "hierarchy_context",
    "source_refs",
    "run_id",
    "run_timestamp",
    "model_version"
  ],
  "properties": {
    "evidence_packet_id": { "type": "string", "minLength": 1 },
    "account_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crm_account_id", "crm_account_name", "country"],
      "properties": {
        "crm_account_id": { "type": ["string", "null"], "minLength": 15, "maxLength": 18 },
        "crm_account_name": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "minLength": 2, "maxLength": 2 },
        "website_domain": { "type": ["string", "null"] }
      }
    },
    "resolved_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolved_entity_id", "identity_confidence"],
      "properties": {
        "resolved_entity_id": { "type": "string", "pattern": "^ent_[A-Za-z0-9_]+$" },
        "sovereign_identity_key": { "type": ["string", "null"] },
        "crm_safe_activation_key": { "type": ["string", "null"], "minLength": 15, "maxLength": 18 },
        "identity_confidence": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "firmographic_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "fact_type",
          "fact_name",
          "fact_value",
          "source_confidence",
          "freshness_status",
          "license_or_contract_reference"
        ],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "fact_type": {
            "type": "string",
            "enum": [
              "company_identity",
              "official_identifier",
              "location",
              "classification",
              "legal_status",
              "financial",
              "workforce_scale",
              "hierarchy_hint",
              "contact_web_presence",
              "digital_signal"
            ]
          },
          "fact_name": { "type": "string", "minLength": 1 },
          "fact_value": { "type": ["string", "number", "integer", "boolean", "null"] },
          "fact_value_normalized": { "type": ["string", "number", "integer", "boolean", "null"] },
          "fact_unit": { "type": ["string", "null"] },
          "fact_period_start": { "type": ["string", "null"], "format": "date" },
          "fact_period_end": { "type": ["string", "null"], "format": "date" },
          "source_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source_reliability_code": { "type": ["string", "null"] },
          "field_completeness_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "freshness_status": { "type": "string", "enum": ["fresh", "stale", "expired", "unknown"] },
          "last_refreshed_at": { "type": "string", "format": "date-time" },
          "license_or_contract_reference": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hierarchy_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known_subsidiary_count",
        "crm_covered_subsidiary_count",
        "external_subsidiaries_found",
        "coverage_gap_flag"
      ],
      "properties": {
        "known_subsidiary_count": { "type": "integer", "minimum": 0 },
        "crm_covered_subsidiary_count": { "type": "integer", "minimum": 0 },
        "external_subsidiaries_found": { "type": "integer", "minimum": 0 },
        "coverage_gap_flag": { "type": "boolean" }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_type", "accessed_at"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "source_type": { "type": "string", "minLength": 1 },
          "document_date": { "type": ["string", "null"], "format": "date" },
          "accessed_at": { "type": "string", "format": "date-time" },
          "source_url": { "type": ["string", "null"], "format": "uri" },
          "excerpt": { "type": ["string", "null"] }
        }
      }
    },
    "run_id": { "type": "string", "minLength": 1 },
    "run_timestamp": { "type": "string", "format": "date-time" },
    "model_version": { "type": "string", "minLength": 1 }
  }
}
