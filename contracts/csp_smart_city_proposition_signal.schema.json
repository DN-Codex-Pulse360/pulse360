{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pulse360/contracts/csp_smart_city_proposition_signal",
  "title": "Pulse360 CSP Smart City Proposition Signal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signal_pack_id",
    "scenario_id",
    "market_region",
    "synthetic_flag",
    "target_entities",
    "associated_b2b_customers",
    "proposition_signals",
    "expected_ground_truth",
    "run_id",
    "run_timestamp",
    "model_version"
  ],
  "properties": {
    "signal_pack_id": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": "string", "minLength": 1 },
    "market_region": { "type": "string", "enum": ["ASEAN"] },
    "synthetic_flag": { "type": "boolean" },
    "target_entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_entity_id",
          "target_entity_name",
          "country_code",
          "market",
          "target_entity_type"
        ],
        "properties": {
          "target_entity_id": { "type": "string", "pattern": "^city_[A-Za-z0-9_]+$" },
          "target_entity_name": { "type": "string", "minLength": 1 },
          "country_code": { "type": "string", "minLength": 2, "maxLength": 2 },
          "market": { "type": "string", "minLength": 1 },
          "target_entity_type": {
            "type": "string",
            "enum": [
              "city",
              "municipality",
              "transport_authority",
              "industrial_zone",
              "campus",
              "property_group",
              "utility"
            ]
          },
          "crm_account_id": { "type": ["string", "null"], "minLength": 15, "maxLength": 18 }
        }
      }
    },
    "associated_b2b_customers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "b2b_customer_id",
          "b2b_customer_name",
          "country_code",
          "market",
          "customer_type",
          "relationship_to_target",
          "priority_offering_families"
        ],
        "properties": {
          "b2b_customer_id": { "type": "string", "pattern": "^b2b_[A-Za-z0-9_]+$" },
          "b2b_customer_name": { "type": "string", "minLength": 1 },
          "country_code": { "type": "string", "minLength": 2, "maxLength": 2 },
          "market": { "type": "string", "minLength": 1 },
          "customer_type": {
            "type": "string",
            "enum": [
              "municipal_agency",
              "transport_authority",
              "parking_operator",
              "property_group",
              "airport_operator",
              "utility",
              "industrial_estate_operator",
              "systems_integrator",
              "iot_platform_partner",
              "data_consumer"
            ]
          },
          "relationship_to_target": { "type": "string", "minLength": 1 },
          "candidate_crm_account_id": { "type": ["string", "null"], "minLength": 15, "maxLength": 18 },
          "priority_offering_families": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "intelligent_parking",
                "urban_data_brokerage",
                "connected_city_iot_platform",
                "smart_waste",
                "smart_lighting",
                "ev_charging",
                "public_safety",
                "smart_transport"
              ]
            }
          }
        }
      }
    },
    "proposition_signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signal_id",
          "target_entity_id",
          "offering_family",
          "offer_bundle",
          "source_family",
          "source_system_name",
          "source_reference",
          "signal_type",
          "signal_timestamp",
          "signal_confidence",
          "weighting_rationale",
          "evidence_summary",
          "consent_privacy_classification",
          "recommended_next_action"
        ],
        "properties": {
          "signal_id": { "type": "string", "minLength": 1 },
          "target_entity_id": { "type": "string", "pattern": "^city_[A-Za-z0-9_]+$" },
          "offering_family": {
            "type": "string",
            "enum": [
              "intelligent_parking",
              "urban_data_brokerage",
              "connected_city_iot_platform",
              "smart_waste",
              "smart_lighting",
              "ev_charging",
              "public_safety",
              "smart_transport"
            ]
          },
          "offer_bundle": { "type": "string", "minLength": 1 },
          "source_family": {
            "type": "string",
            "enum": [
              "municipal_open_data",
              "csp_network",
              "iot_telemetry",
              "public_sector_trigger",
              "partner_ecosystem",
              "mobility_data",
              "environmental_data",
              "data_marketplace"
            ]
          },
          "source_system_name": { "type": "string", "minLength": 1 },
          "source_reference": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "source_uri", "retrieved_at"],
            "properties": {
              "source_id": { "type": "string", "minLength": 1 },
              "source_uri": { "type": "string", "minLength": 1 },
              "retrieved_at": { "type": "string", "format": "date-time" }
            }
          },
          "signal_type": { "type": "string", "minLength": 1 },
          "signal_timestamp": { "type": "string", "format": "date-time" },
          "signal_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "weighting_rationale": { "type": "string", "minLength": 1 },
          "evidence_summary": { "type": "string", "minLength": 1 },
          "consent_privacy_classification": {
            "type": "string",
            "enum": [
              "public",
              "aggregated_anonymized",
              "customer_permissioned",
              "restricted_review_required",
              "blocked"
            ]
          },
          "recommended_next_action": { "type": "string", "minLength": 1 },
          "source_payload": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "expected_ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_target_entity_id",
        "priority_offering_family",
        "expected_activation_state",
        "known_edge_cases"
      ],
      "properties": {
        "primary_target_entity_id": { "type": "string", "pattern": "^city_[A-Za-z0-9_]+$" },
        "priority_offering_family": {
          "type": "string",
          "enum": [
            "intelligent_parking",
            "urban_data_brokerage",
            "connected_city_iot_platform",
            "smart_waste",
            "smart_lighting",
            "ev_charging",
            "public_safety",
            "smart_transport"
          ]
        },
        "expected_activation_state": {
          "type": "string",
          "enum": ["activation_safe", "review_required", "blocked"]
        },
        "known_edge_cases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "run_id": { "type": "string", "minLength": 1 },
    "run_timestamp": { "type": "string", "format": "date-time" },
    "model_version": { "type": "string", "minLength": 1 }
  }
}
