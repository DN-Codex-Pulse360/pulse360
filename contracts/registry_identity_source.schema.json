{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pulse360/contracts/registry_identity_source",
  "title": "Pulse360 Registry Identity Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_source_id",
    "source_system",
    "country_of_incorporation",
    "national_id_type",
    "national_id_value",
    "registered_legal_name",
    "source_confidence",
    "last_refreshed_at",
    "source_refs"
  ],
  "properties": {
    "registry_source_id": { "type": "string", "minLength": 1 },
    "source_system": { "type": "string", "minLength": 1 },
    "country_of_incorporation": { "type": "string", "minLength": 2, "maxLength": 2 },
    "national_id_type": { "type": "string", "minLength": 1 },
    "national_id_value": { "type": "string", "minLength": 1 },
    "registered_legal_name": { "type": "string", "minLength": 1 },
    "normalized_legal_name": { "type": "string" },
    "source_confidence": { "type": "number", "minimum": 0, "maximum": 100 },
    "last_refreshed_at": { "type": "string", "format": "date-time" },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_name", "source_type", "source_url", "accessed_at", "excerpt"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "source_name": { "type": "string", "minLength": 1 },
          "source_type": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string", "format": "uri" },
          "document_date": { "type": "string", "format": "date" },
          "accessed_at": { "type": "string", "format": "date-time" },
          "excerpt": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
