{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pulse360/contracts/synthetic_enterprise_source_pack",
  "title": "Pulse360 Synthetic Enterprise Source Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_pack_id",
    "scenario_id",
    "synthetic_flag",
    "generation_seed",
    "source_records",
    "expected_ground_truth",
    "run_id",
    "run_timestamp",
    "model_version"
  ],
  "properties": {
    "source_pack_id": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": "string", "minLength": 1 },
    "synthetic_flag": { "type": "boolean" },
    "generation_seed": { "type": "string", "minLength": 1 },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_record_id",
          "source_family",
          "source_system_name",
          "entity_key",
          "event_type",
          "event_timestamp",
          "business_object_id",
          "source_confidence",
          "source_payload",
          "edge_case_tags"
        ],
        "properties": {
          "source_record_id": { "type": "string", "minLength": 1 },
          "source_family": {
            "type": "string",
            "enum": [
              "erp",
              "epm",
              "support",
              "contracts",
              "product_telemetry",
              "marketing_intent",
              "internal_hierarchy"
            ]
          },
          "source_system_name": { "type": "string", "minLength": 1 },
          "entity_key": { "type": "string", "minLength": 1 },
          "crm_account_id": { "type": ["string", "null"], "minLength": 15, "maxLength": 18 },
          "event_type": { "type": "string", "minLength": 1 },
          "event_timestamp": { "type": "string", "format": "date-time" },
          "business_object_id": { "type": "string", "minLength": 1 },
          "source_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source_payload": {
            "type": "object",
            "additionalProperties": true
          },
          "edge_case_tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "expected_ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolved_entity_id",
        "crm_account_id",
        "expected_signals",
        "expected_activation_state",
        "known_edge_cases"
      ],
      "properties": {
        "resolved_entity_id": { "type": "string", "pattern": "^ent_[A-Za-z0-9_]+$" },
        "crm_account_id": { "type": ["string", "null"], "minLength": 15, "maxLength": 18 },
        "expected_signals": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_activation_state": {
          "type": "string",
          "enum": ["activation_safe", "review_required", "blocked"]
        },
        "known_edge_cases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "run_id": { "type": "string", "minLength": 1 },
    "run_timestamp": { "type": "string", "format": "date-time" },
    "model_version": { "type": "string", "minLength": 1 }
  }
}
