{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pulse360/contracts/weighted_attribute_resolution",
  "title": "Pulse360 Weighted Attribute Resolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attribute_resolution_id",
    "entity_anchor_id",
    "source_account_id",
    "resolved_entity_id",
    "attribute_path",
    "attribute_name",
    "winning_value",
    "winning_source_id",
    "survivorship_rule",
    "confidence",
    "freshness_status",
    "source_contribution_count",
    "conflict_count",
    "source_contributions",
    "source_refs",
    "license_or_contract_references",
    "last_resolved_at",
    "run_id",
    "model_version"
  ],
  "properties": {
    "attribute_resolution_id": { "type": "string", "pattern": "^wattr_[a-f0-9]{64}$" },
    "entity_anchor_id": { "type": "string", "minLength": 1 },
    "source_account_id": { "type": ["string", "null"] },
    "resolved_entity_id": { "type": ["string", "null"] },
    "attribute_path": { "type": "string", "minLength": 1 },
    "attribute_name": { "type": "string", "minLength": 1 },
    "fact_type": { "type": "string", "minLength": 1 },
    "winning_value": { "type": ["string", "number", "integer", "boolean", "null"] },
    "winning_value_normalized": { "type": ["string", "number", "integer", "boolean", "null"] },
    "fact_unit": { "type": ["string", "null"] },
    "winning_source_id": { "type": "string", "minLength": 1 },
    "winning_source_family": {
      "type": "string",
      "enum": [
        "national_registry",
        "commercial_provider_marketplace",
        "customer_internal",
        "internet_research",
        "clean_room_collaboration",
        "crm",
        "neutral_fixture"
      ]
    },
    "survivorship_rule": {
      "type": "string",
      "enum": [
        "highest_weighted_confidence",
        "official_source_priority",
        "crm_fallback",
        "aggregate_only",
        "manual_review_required"
      ]
    },
    "resolution_status": {
      "type": "string",
      "enum": ["selected", "corroborated", "single_source", "conflict_review_required", "insufficient_evidence"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "freshness_status": { "type": "string", "enum": ["fresh", "stale", "expired", "unknown"] },
    "source_contribution_count": { "type": "integer", "minimum": 1 },
    "conflict_count": { "type": "integer", "minimum": 0 },
    "source_contributions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source_contribution" }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "license_or_contract_references": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "last_resolved_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "source_contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_family",
        "source_system",
        "source_type",
        "source_record_id",
        "source_confidence",
        "source_weight",
        "freshness_score",
        "field_completeness_score",
        "contribution_score",
        "selected_flag",
        "license_or_contract_reference",
        "run_id"
      ],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "source_family": {
          "type": "string",
          "enum": [
            "national_registry",
            "commercial_provider_marketplace",
            "customer_internal",
            "internet_research",
            "clean_room_collaboration",
            "crm",
            "neutral_fixture"
          ]
        },
        "source_system": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "minLength": 1 },
        "source_record_id": { "type": "string", "minLength": 1 },
        "source_url": { "type": ["string", "null"] },
        "source_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "freshness_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "field_completeness_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "contribution_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "selected_flag": { "type": "boolean" },
        "rejection_reason": { "type": ["string", "null"] },
        "source_excerpt": { "type": ["string", "null"] },
        "license_or_contract_reference": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
