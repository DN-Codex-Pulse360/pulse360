{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pulse360/contracts/databricks_activation_review_queue_to_datacloud",
  "title": "Databricks Activation Review Queue To Data Cloud Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_queue_id",
    "source_product",
    "source_record_id",
    "resolved_entity_id",
    "source_refs",
    "crm_activation_candidate_ids",
    "crm_activation_candidate_names",
    "crm_activation_candidate_count",
    "activation_resolution_hint",
    "confidence_score",
    "confidence_components",
    "freshness_status",
    "activation_eligible_flag",
    "activation_block_reasons",
    "lineage_status",
    "model_id",
    "prompt_version",
    "enrichment_run_id",
    "source_run_timestamp",
    "ingestion_metadata_label",
    "run_id",
    "run_timestamp",
    "model_version"
  ],
  "properties": {
    "review_queue_id": { "type": "string", "minLength": 1 },
    "source_product": { "type": "string", "minLength": 1 },
    "source_record_id": { "type": "string", "minLength": 1 },
    "resolved_entity_id": { "type": "string", "minLength": 1 },
    "crm_activation_key": {
      "type": ["string", "null"],
      "minLength": 15,
      "maxLength": 18
    },
    "source_refs": { "type": "string", "minLength": 1 },
    "crm_activation_candidate_ids": { "type": "string", "minLength": 2 },
    "crm_activation_candidate_names": { "type": "string", "minLength": 2 },
    "crm_activation_candidate_count": { "type": "integer", "minimum": 0 },
    "activation_resolution_hint": { "type": "string", "minLength": 1 },
    "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence_components": { "type": "string", "minLength": 1 },
    "target_entity_name": { "type": ["string", "null"], "minLength": 1 },
    "country_code": { "type": ["string", "null"], "minLength": 2, "maxLength": 2 },
    "market": { "type": ["string", "null"], "minLength": 1 },
    "offering_family": {
      "type": ["string", "null"],
      "enum": [
        "intelligent_parking",
        "urban_data_brokerage",
        "connected_city_iot_platform",
        "smart_waste",
        "smart_lighting",
        "ev_charging",
        "public_safety",
        "smart_transport",
        null
      ]
    },
    "offer_bundle": { "type": ["string", "null"], "minLength": 1 },
    "target_b2b_customer_ids": { "type": ["string", "null"], "minLength": 2 },
    "target_b2b_customer_names": { "type": ["string", "null"], "minLength": 2 },
    "recommended_next_actions": { "type": ["string", "null"], "minLength": 2 },
    "review_priority": {
      "type": ["string", "null"],
      "enum": [
        "activation_candidate",
        "account_mapping_review",
        "governance_review",
        "evidence_build_required",
        null
      ]
    },
    "freshness_status": { "type": "string", "minLength": 1 },
    "activation_eligible_flag": { "type": "boolean" },
    "activation_block_reasons": { "type": "string", "minLength": 2 },
    "lineage_status": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "prompt_version": { "type": ["string", "null"] },
    "enrichment_run_id": { "type": "string", "minLength": 1 },
    "source_run_timestamp": { "type": "string", "format": "date-time" },
    "ingestion_metadata_label": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "run_ts": { "type": "string", "format": "date-time" },
    "run_timestamp": { "type": "string", "format": "date-time" },
    "model_version": { "type": "string", "minLength": 1 }
  }
}
